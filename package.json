{
	"name": "throughline",
	"version": "2.0.0",
	"description": "A focus editor for long-form writing with background analysis by a local language model. Installable PWA built with Angular.",
	"private": true,
	"type": "module",
	"engines": {
		"node": "^22.12.0 || >=24.0.0"
	},
	"scripts": {
		"start": "ng serve",
		"build": "ng build",
		"preview": "npx --yes http-server dist/throughline/browser -p 8080 -c-1",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
	},
	"imports": {
		"#fixtures": {
			"browser": "./tools/browser-test/fixtures.browser.ts",
			"default": "./test/support/fixtures.node.ts"
		}
	},
	"dependencies": {
		"@angular/common": "^22.0.0",
		"@angular/compiler": "^22.0.0",
		"@angular/core": "^22.0.0",
		"@angular/platform-browser": "^22.0.0",
		"@angular/service-worker": "^22.0.0",
		"rxjs": "~7.8.0",
		"tslib": "^2.8.0"
	},
	"devDependencies": {
		"@angular/build": "^22.0.0",
		"@angular/cli": "^22.0.0",
		"@angular/compiler-cli": "^22.0.0",
		"@types/node": "^22.0.0",
		"jsdom": "^26.0.0",
		"typescript": "~6.0.0",
		"vitest": "^4.0.0"
	}
}
